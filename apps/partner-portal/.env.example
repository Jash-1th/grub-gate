# GrubGate Partner Portal Environment Variables
# Copy this file to .env.local and configure as needed

# PWA Configuration
# VAPID keys for push notifications (optional for development)
# Generate keys using: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Logging Configuration
# Options: debug, info, warn, error
VITE_LOG_LEVEL=debug

# Feature Flags (optional)
# Set to true/1/enabled to enable features
VITE_FEATURE_PWA_INSTALL=true
VITE_FEATURE_PUSH_NOTIFICATIONS=true
VITE_FEATURE_DEV_TOOLS=true

# API Configuration (if needed)
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# Analytics (if needed)
VITE_GA_TRACKING_ID=your_ga_id_here

# Note: Only variables prefixed with VITE_ will be available in the browser
# Other variables are server-side only