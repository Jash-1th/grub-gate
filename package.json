{
  "name": "grub-gate-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm run dev --workspace=customer-app",
    "dev:partner": "npm run dev --workspace=partner-portal",
    "dev:dasher": "npm run dev --workspace=dasher-app",
    "build:customer": "npm run build --workspace=customer-app",
    "build:partner": "npm run build --workspace=partner-portal",
    "build:dasher": "npm run build --workspace=dasher-app",
    "build:all": "npm run build:customer && npm run build:partner && npm run build:dasher",
    "dev:all": "concurrently \"npm run dev:customer\" \"npm run dev:partner\" \"npm run dev:dasher\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "terser": "^5.44.0",
    "patch-package": "^8.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.52.4"
  }
}
